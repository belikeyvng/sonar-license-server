# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Paystack test-mode secret key (starts with sk_test_)
PAYSTACK_SECRET_KEY="sk_test_e8b6faa609f0c896244412b28913469a3680fce1"

# Port the server listens on locally. Railway sets its own PORT env var
# in production — this is only used as a local fallback.
PORT=4000

# Once deployed (Railway etc.), set this to the real public URL so
# generated callback_url values are correct. Leave as localhost for
# local dev.
PUBLIC_BASE_URL=http://localhost:4000
